\"b010207\" data-element_type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-no\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-95cf2ed\" data-id=\"95cf2ed\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-01579a4 elementor-widget elementor-widget-elementskit-heading\" data-id=\"01579a4\" data-element_type=\"widget\" data-widget_type=\"elementskit-heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"ekit-wid-con\"><div class=\"ekit-heading elementskit-section-title-wraper center   ekit_heading_tablet-   ekit_heading_mobile-\"><h2 class=\"ekit-heading--title elementskit-section-title \">Our Applications In This Industry<\/h2><div class=\"ekit_heading_separetor_wraper ekit_heading_elementskit-border-divider ekit-dotted\"><div class=\"elementskit-border-divider ekit-dotted\"><\/div><\/div><\/div><\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-3d73175 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"3d73175\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-e4225fb\" data-id=\"e4225fb\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-c895962 ekit-equal-height-enable elementor-widget elementor-widget-elementskit-image-box\" data-id=\"c895962\" data-element_type=\"widget\" data-widget_type=\"elementskit-image-box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"ekit-wid-con\">\n            <div class=\"elementskit-info-image-box ekit-image-box text-center style-modern\">\n\n                \n                <div class=\"elementskit-box-header image-box-img-center\">\n\n                    <img decoding=\"async\" src=\"https:\/\/rajbarcode.com\/wp-content\/uploads\/elementor\/thumbs\/chemical-1-qk63jekp6vqny5xomc1uq65g09guworngzkd7vt0d2.png\" title=\"chemical\" alt=\"chemical\" loading=\"lazy\" \/>\n                <\/div>\n                \n                <div class=\"elementskit-box-body ekit-image-box-body\">\n                    <div class=\"elementskit-box-content ekit-image-box-body-inner\">\n                                                <h5 class=\"elementskit-info-box-title\">\n\n                        1. Machine Vision\n                        \n                    <\/h5>\n                                                            <div class=\"elementskit-box-style-content\">\n                        Our Machine Vision solutions utilize advanced imaging technology to inspect and verify chemical products, ensuring compliance with quality standards and regulatory requirements. By automating quality control processes, chemical manufacturers can enhance product reliability, reduce risks, and safeguard customer satisfaction.                    <\/div>\n                                    <\/div>\n\n                            <\/div>\n            <\/div>\n    <\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-896f2d4\" data-id=\"896f2d4\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-db1fd33 ekit-equal-height-enable elementor-widget elementor-widget-elementskit-image-box\" data-id=\"db1fd33\" data-element_type=\"widget\" data-widget_type=\"elementskit-image-box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"ekit-wid-con\">\n            <div class=\"elementskit-info-image-box ekit-image-box text-center style-modern\">\n\n                \n                <div class=\"elementskit-box-header image-box-img-center\">\n\n                    <img decoding=\"async\" width=\"500\" height=\"350\" src=\"https:\/\/rajbarcode.com\/wp-content\/uploads\/2024\/02\/chemical-2-1.png\" class=\"attachment-full size-full wp-image-14269\" alt=\"\" srcset=\"https:\/\/rajbarcode.com\/wp-content\/uploads\/2024\/02\/chemical-2-1.png 500w, https:\/\/rajbarcode.com\/wp-content\/uploads\/2024\/02\/chemical-2-1-300x210.png 300w\" sizes=\"(max-width: 500px) 100vw, 500px\" \/>\n                <\/div>\n                \n                <div class=\"elementskit-box-body ekit-image-box-body\">\n                    <div class=\"elementskit-box-content ekit-image-box-body-inner\">\n                                                <h5 class=\"elementskit-info-box-title\">\n\n                        2. Warehouse Management\n                        \n                    <\/h5>\n                                                            <div class=\"elementskit-box-style-content\">\n                        Our Warehouse Management System (WMS) provides chemical companies with real-time visibility into inventory levels, facilitates accurate stock tracking, and streamlines order fulfillment processes.                     <\/div>\n                                    <\/div>\n\n                            <\/div>\n            <\/div>\n    <\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-da2d0b1\" data-id=\"da2d0b1\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-d6f3cfa ekit-equal-height-enable elementor-widget elementor-widget-elementskit-image-box\" data-id=\"d6f3cfa\" data-element_type=\"widget\" data-widget_type=\"elementskit-image-box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"ekit-wid-con\">\n            <div class=\"elementskit-info-image-box ekit-image-box text-center style-modern\">\n\n                \n                <div class=\"elementskit-box-header image-box-img-center\">\n\n                    <img decoding=\"async\" src=\"https:\/\/rajbarcode.com\/wp-content\/uploads\/elementor\/thumbs\/chemical-3-qk63j8xo1viy0i5vj9m3b7kofy8nmi59g7ngc81dee.png\" title=\"chemical (3)\" alt=\"chemical (3)\" loading=\"lazy\" \/>\n                <\/div>\n                \n                <div class=\"elementskit-box-body ekit-image-box-body\">\n                    <div class=\"elementskit-box-content ekit-image-box-body-inner\">\n                                                <h5 class=\"elementskit-info-box-title\">\n\n                        3. Industry 4.0 and iIOT\n                        \n                    <\/h5>\n                                                            <div class=\"elementskit-box-style-content\">\n                        . Our Industry 4.0 and IIoT solutions enable seamless connectivity and data exchange between equipment, systems, and processes, empowering chemical companies to monitor performance in real-time, predict maintenance needs, and optimize resource utilization.                     <\/div>\n                                    <\/div>\n\n                            <\/div>\n            <\/div>\n    <\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-e4ba4a1 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"e4ba4a1\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-14d770a\" data-id=\"14d770a\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-06cfcbe ekit-equal-height-enable elementor-widget elementor-widget-elementskit-image-box\" data-id=\"06cfcbe\" data-element_type=\"widget\" data-widget_type=\"elementskit-image-box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"ekit-wid-con\">\n            <div class=\"elementskit-info-image-box ekit-image-box text-center style-modern\">\n\n                \n                <div class=\"elementskit-box-header image-box-img-center\">\n\n                    <img decoding=\"async\" src=\"https:\/\/rajbarcode.com\/wp-content\/uploads\/elementor\/thumbs\/chemical-2-qk63iuu37czn6cqctliort4rj665f1lae9v652m9zq.png\" title=\"chemical (2)\" alt=\"chemical (2)\" loading=\"lazy\" \/>\n                <\/div>\n                \n                <div class=\"elementskit-box-body ekit-image-box-body\">\n                    <div class=\"elementskit-box-content ekit-image-box-body-inner\">\n                                                <h5 class=\"elementskit-info-box-title\">\n\n                        4. Label managment software\n                        \n                    <\/h5>\n                                                            <div class=\"elementskit-box-style-content\">\n                        Our Label Management System simplifies the creation, printing, and management of chemical labels, incorporating industry-specific information such as hazard symbols, safety instructions, and regulatory codes. With customizable label templates and seamless integration with GHS standards, our solution helps chemical companies meet labeling requirements and enhance product safety.                    <\/div>\n                                    <\/div>\n\n                            <\/div>\n            <\/div>\n    <\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-23a0d26\" data-id=\"23a0d26\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-1434346 ekit-equal-height-enable elementor-widget elementor-widget-elementskit-image-box\" data-id=\"1434346\" data-element_type=\"widget\" data-widget_type=\"elementskit-image-box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"ekit-wid-con\">\n            <div class=\"elementskit-info-image-box ekit-image-box text-center style-modern\">\n\n                \n                <div class=\"elementskit-box-header image-box-img-center\">\n\n                    <img decoding=\"async\" width=\"500\" height=\"350\" src=\"https:\/\/rajbarcode.com\/wp-content\/uploads\/2024\/02\/sanitaryware.png\" class=\"attachment-full size-full wp-image-14215\" alt=\"\" srcset=\"https:\/\/rajbarcode.com\/wp-content\/uploads\/2024\/02\/sanitaryware.png 500w, https:\/\/rajbarcode.com\/wp-content\/uploads\/2024\/02\/sanitaryware-300x210.png 300w\" sizes=\"(max-width: 500px) 100vw, 500px\" \/>\n                <\/div>\n                \n                <div class=\"elementskit-box-body ekit-image-box-body\">\n                    <div class=\"elementskit-box-content ekit-image-box-body-inner\">\n                                                <h5 class=\"elementskit-info-box-title\">\n\n                        5. Track and Trace\n                        \n                    <\/h5>\n                                                            <div class=\"elementskit-box-style-content\">\n                        Our Track and Trace solution provides end-to-end visibility into product movements, from manufacturing facilities to distribution centers and end-users. By leveraging serialization and barcode technology, chemical companies can track individual units, monitor storage conditions, and quickly respond to quality issues or recalls, thereby enhancing product authenticity and customer trust.                    <\/div>\n                                    <\/div>\n\n                            <\/div>\n            <\/div>\n    <\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-f818579\" data-id=\"f818579\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-4a57ff4 ekit-equal-height-enable elementor-widget elementor-widget-elementskit-image-box\" data-id=\"4a57ff4\" data-element_type=\"widget\" data-widget_type=\"elementskit-image-box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"ekit-wid-con\">\n            <div class=\"elementskit-info-image-box ekit-image-box text-center style-modern\">\n\n                \n                <div class=\"elementskit-box-header image-box-img-center\">\n\n                    <img decoding=\"async\" src=\"https:\/\/rajbarcode.com\/wp-content\/uploads\/elementor\/thumbs\/warehouse-management-innovative-software-computer-real-time-monitoring_31965-21147-e1695487151255-qk2lm2qfztydxiuk2s0ta5290ho3kjrlj3cplpf1g6.jpg\" title=\"warehouse-management-innovative-software-computer-real-time-monitoring_31965-21147\" alt=\"warehouse-management-innovative-software-computer-real-time-monitoring_31965-21147\" loading=\"lazy\" \/>\n                <\/div>\n                \n                <div class=\"elementskit-box-body ekit-image-box-body\">\n                    <div class=\"elementskit-box-content ekit-image-box-body-inner\">\n                                                <h5 class=\"elementskit-info-box-title\">\n\n                        6. Mobilizing ERP\n                        \n                    <\/h5>\n                                                            <div class=\"elementskit-box-style-content\">\n                        Our Mobilizing ERP solution extends the capabilities of Enterprise Resource Planning (ERP) systems to mobile devices, enabling seamless access to critical information such as inventory levels, production schedules, and regulatory documentation. With enhanced mobility and connectivity, chemical companies can improve operational efficiency, ensure compliance with regulatory standards, and enhance overall business performance.                    <\/div>\n                                    <\/div>\n\n                            <\/div>\n            <\/div>\n    <\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-9aea492 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"9aea492\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-cc6c9f0\" data-id=\"cc6c9f0\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-a4544de ekit-equal-height-enable elementor-widget elementor-widget-elementskit-image-box\" data-id=\"a4544de\" data-element_type=\"widget\" data-widget_type=\"elementskit-image-box.default\">\n\t\t\t\t<div class=\"ele