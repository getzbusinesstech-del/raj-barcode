t_type=\"elementskit-image-box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"ekit-wid-con\">\n            <div class=\"elementskit-info-image-box ekit-image-box text-center style-modern\">\n\n                \n                <div class=\"elementskit-box-header image-box-img-center\">\n\n                    <img decoding=\"async\" width=\"500\" height=\"350\" src=\"https:\/\/rajbarcode.com\/wp-content\/uploads\/2024\/02\/automotives-2-1.png\" class=\"attachment-full size-full wp-image-14239\" alt=\"\" srcset=\"https:\/\/rajbarcode.com\/wp-content\/uploads\/2024\/02\/automotives-2-1.png 500w, https:\/\/rajbarcode.com\/wp-content\/uploads\/2024\/02\/automotives-2-1-300x210.png 300w\" sizes=\"(max-width: 500px) 100vw, 500px\" \/>\n                <\/div>\n                \n                <div class=\"elementskit-box-body ekit-image-box-body\">\n                    <div class=\"elementskit-box-content ekit-image-box-body-inner\">\n                                                <h5 class=\"elementskit-info-box-title\">\n\n                        2. Work in progress tracking\n                        \n                    <\/h5>\n                                                            <div class=\"elementskit-box-style-content\">\n                        Our Work In-Progress solution enables automotive manufacturers to track the status of each vehicle or component in real-time, identify potential bottlenecks, and optimize workflow efficiency. By streamlining production processes and minimizing idle time, businesses can improve productivity and meet production targets with greater precision.                    <\/div>\n                                    <\/div>\n\n                            <\/div>\n            <\/div>\n    <\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-da2d0b1\" data-id=